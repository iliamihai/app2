<div class="container">
    <div class="breadcrumbs">Afiliere / {$pagetitle}</div>
    <div class="section-title">
        <h2>Program afiliere</h2>
        <span class="badge">Castiga cu fiecare recomandare</span>
    </div>
    <div class="grid cols-2">
        <div class="card">
            <h3>Statistici afiliat</h3>
            <p>Comision curent: <strong>{$balance}</strong></p>
            <p>Total recomandari: <strong>{$visitors}</strong></p>
            <p>Conversii: <strong>{$signups}</strong></p>
        </div>
        <div class="card">
            <h3>Link afiliat</h3>
            <p>Distribuie link-ul tau si castiga pana la 30% comision.</p>
            <div class="notice">
                {$affiliatelink}
            </div>
        </div>
    </div>
</div>
